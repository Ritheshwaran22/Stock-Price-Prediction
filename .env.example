# Stock Market Management System - Environment Configuration
# Copy this file to .env and configure your local settings if needed.

# Application Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Optional: Finviz Request User-Agent
FINVIZ_USER_AGENT=StockMarketApp/1.0

# Optional: Cache Expiry (seconds)
CACHE_TTL_SECONDS=3600

